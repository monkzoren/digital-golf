# Local development only (`npm run dev`). Copy to .env.local and fill in.
# Docker/Compose builds get the same values as build args from the repo-root
# .env (see .env.example there). Use the project SHARED by every Digital game.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=digital-tennis
VITE_FIREBASE_APP_ID=
