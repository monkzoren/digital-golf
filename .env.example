# Copy to .env and adjust. Nothing here is required for a default deploy:
# the client talks to SpacetimeDB same-origin (nginx proxies /v1).

# SpacetimeDB database (module) name.
DATABASE_NAME=digital-golf

# Host port for the web client.
CLIENT_PORT=8080

# Only if you expose SpacetimeDB directly (see docker-compose.yml).
SPACETIMEDB_PORT=3000

# --- Player accounts (optional, REQUIRED for championships) -----------------
# Firebase Auth gives every player a STABLE identity. Use the SAME project as
# Digital Tennis, Racing, Football and the championship hub: SpacetimeDB
# derives the identity from the token's iss+sub, so one project means one
# identity per player across every game — which is what lets the hub match
# a round's finishing order to its entrants. Leave empty and players get
# anonymous SpacetimeDB identities kept in this browser only.
#FIREBASE_API_KEY=
#FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
#FIREBASE_PROJECT_ID=digital-tennis
#FIREBASE_APP_ID=

# Wipe the database when a breaking schema change won't publish. Player-made
# courses live in the database — leave this empty unless you mean it.
#ALLOW_CLEAR=
